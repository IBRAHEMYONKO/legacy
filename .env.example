# =========================================================
# LEGACY - LOCAL DEVELOPMENT
# =========================================================

NODE_ENV=development

# Services
API_PORT=4000
WEB_PORT=5173
ACTIVITY_PORT=5174
WEB_URL=http://localhost:5173
ACTIVITY_URL=http://localhost:5174

# Session / internal security
JWT_SECRET=change-me-to-a-long-random-secret
LEGACY_INTERNAL_KEY=change-me-to-another-long-random-secret

# =========================================================
# DATABASE
# =========================================================
# Local mode uses embedded PGlite. No PostgreSQL installation is required.
LEGACY_DB_MODE=local
LEGACY_DB_PATH=backend/data/legacy

# Only needed when using PostgreSQL / Supabase instead of local mode.
DATABASE_URL=postgresql://postgres:password@localhost:5432/legacy

# =========================================================
# DISCORD OAUTH - WEBSITE LOGIN
# =========================================================
# Use the Application ID / Client ID from Discord Developer Portal.
# The Bot Token below must belong to the bot user of this same application.
DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:4000/auth/discord/callback

# Frontend does not need the Client Secret.
VITE_API_URL=http://localhost:4000
VITE_DISCORD_CLIENT_ID=your-discord-application-id

# =========================================================
# DISCORD ACTIVITY
# =========================================================
# Keep this identical to the redirect URI registered for the Activity OAuth flow.
# The backend endpoint receiving the Activity authorization code is /activity/auth.
DISCORD_ACTIVITY_CLIENT_ID=
DISCORD_ACTIVITY_REDIRECT_URI=http://localhost:4000/auth/discord/callback

# =========================================================
# DISCORD BOT + REQUIRED LEGACY SERVER
# =========================================================
DISCORD_BOT_TOKEN=your-discord-bot-token
# Invite code of the mandatory LEGACY server.
# The application resolves the guild ID from this invite automatically.
LEGACY_GUILD_INVITE=ufEneEgpSA

# Comma-separated Discord user IDs with LEGACY admin access.
LEGACY_ADMIN_IDS=your-discord-user-id
